[Unit]
Description=polign_db memory node B (cold-first, shared memory store for polign.com/memory-demo)
Documentation=https://github.com/Polign/polign_memory_demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polign
Group=polign

# Two of these run on the demo host (A on 23400, B on 23402), both on the same
# bucket prefix. That is deliberate: agent A writes through this node and
# agent B reads through the other, so a memory the visitor sees survive the
# hop was never shared through a process, only through the store.
#
# -require-data-key: every visitor uses a key bound to their own namespace,
# minted by the demo backend with polign-apikey against this same prefix.
# The node enforces the namespace on every read and write.
#
# -cold-first with -tail-fresh: reads are served from the bucket plus the
# write-log tail, so a node holds no copy of the memories. The other node
# catches up through the write log; the backend hands it the write token
# from any mutation before a turn, so cross-node reads are read-your-writes.
#
# The memory collection is tiny; the caches are sized to stay out of the way
# of the Wikipedia node on the same 2 GB box.
Environment=GOMEMLIMIT=200MiB
Environment=AWS_REGION=us-west-1
ExecStart=/opt/polign/bin/polign-server-0.7.3 \
    -telemetry-id-file /var/lib/polign/memory-b/telemetry-install-id \
    -store s3://polign-demo-wiki-en-uw1/memory-live \
    -cold-first \
    -tail-fresh \
    -require-data-key \
    -http 127.0.0.1:23402 \
    -grpc 127.0.0.1:23403 \
    -disk-cache-dir /var/lib/polign/memory-b/disk-cache \
    -disk-cache-bytes 268435456 \
    -segment-cache-bytes 33554432

Restart=always
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/polign
StateDirectory=polign

[Install]
WantedBy=multi-user.target
