# Browser authentication. Generate the password with: openssl rand -hex 32
DSTACK_USERNAME=polign
DSTACK_PASSWORD=replace-with-a-random-password

# Choose one model provider and supply its key.
MODEL_PROVIDER=anthropic
MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# For OpenAI or an OpenAI-compatible confidential inference endpoint:
# MODEL_PROVIDER=openai
# MODEL=gpt-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Required for dstack/Phala deployment: use the digest emitted by container CI.
# MEMORY_DEMO_IMAGE=ghcr.io/polign/polign-memory-demo@sha256:...

# Optional local host port.
# MEMORY_DEMO_PORT=18080

# Required dstack/Phala storage. The bucket must already exist. Always use a
# dedicated prefix; the base Compose file does not fall back to local disk.
POLIGN_STORE=s3://my-polign-bucket/memory-demo
POLIGN_STORE_REGION=us-west-2

# Recommended Phala credential path: seal a narrowly scoped AWS source
# principal into the CVM. It needs sts:AssumeRole on POLIGN_STORE_ROLE_ARN but
# no direct S3 access. Include AWS_SESSION_TOKEN only when the source credential
# is temporary.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
POLIGN_STORE_ROLE_ARN=arn:aws:iam::123456789012:role/polign-memory-store
POLIGN_STORE_EXTERNAL_ID=replace-with-a-random-deployment-specific-value

# Direct access is supported for a same-account proof of concept: omit the
# role variables, set AWS_REGION, and grant the source principal access to the
# S3 prefix. Role assumption is preferred because the sealed source key can be
# limited to sts:AssumeRole.
# AWS_REGION=us-west-2
